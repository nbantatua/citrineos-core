# Stage 1: Build Next.js Operator UI
FROM node:24-bookworm-slim AS ui-builder
RUN corepack enable
WORKDIR /app
COPY . .

# Build-time public URLs passed via Northflank Build Arguments
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_WS_URL
ARG NEXT_PUBLIC_CITRINE_CORE_URL
ARG NEXT_PUBLIC_HASURA_ADMIN_SECRET
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_WS_URL=$NEXT_PUBLIC_WS_URL
ENV NEXT_PUBLIC_CITRINE_CORE_URL=$NEXT_PUBLIC_CITRINE_CORE_URL
ENV NEXT_PUBLIC_HASURA_ADMIN_SECRET=$NEXT_PUBLIC_HASURA_ADMIN_SECRET

RUN pnpm install --frozen-lockfile
RUN pnpm --filter @citrineos/operator-ui... build

# Stage 2: Hasura CLI-Migrations Runtime + Node.js for Next.js UI
FROM hasura/graphql-engine:v2.45.0.cli-migrations-v3

COPY --from=ui-builder /usr/local/bin/node /usr/local/bin/node
COPY --from=ui-builder /app /app

# Copy CitrineOS Hasura metadata so tables & relationships auto-track on startup
COPY apps/ocpp-server/db/hasura-metadata /hasura-metadata

COPY start-hasura-ui.sh /usr/local/bin/start-hasura-ui.sh
RUN chmod +x /usr/local/bin/start-hasura-ui.sh

EXPOSE 8090 3000
CMD ["/usr/local/bin/start-hasura-ui.sh"]
